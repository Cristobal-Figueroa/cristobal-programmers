@page "/sales/new"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.EntityFrameworkCore
@using StockWise.Data
@using StockWise.Helpers
@using StockWise.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>New Sale - StockWise</PageTitle>

<h1>New Sale</h1>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!loaded)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row g-2 mb-3 col-md-8">
        <div class="col-md-6">
            <select class="form-select" @bind="selectedProductId">
                @foreach (var p in availableProducts)
                {
                    <option value="@p.Id">@p.Name (@p.Stock in stock)</option>
                }
                @if (availableProducts.Count == 0)
                {
                    <option value="0">No products with stock</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <input type="number" class="form-control" min="1" @bind="quantity" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-primary w-100" @onclick="AddLine">Add item</button>
        </div>
    </div>

    @if (lines.Count == 0)
    {
        <p class="text-muted">The sale has no items yet.</p>
    }
    else
    {
        <table class="table" style="max-width: 700px">
            <thead>
                <tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var l in lines)
                {
                    <tr>
                        <td>@l.ProductName</td>
                        <td>@l.Quantity</td>
                        <td>@FormatHelper.CLP(l.UnitPrice)</td>
                        <td>@FormatHelper.CLP(l.Subtotal)</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => lines.Remove(l)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="mt-2">Total: @FormatHelper.CLP(lines.Sum(l => l.Subtotal))</h4>
        <button class="btn btn-success mt-2" @onclick="RegisterSaleAsync">Register Sale</button>
    }
}

@code {
    private List<Product> products = new();
    private List<SaleLine> lines = new();
    private int selectedProductId;
    private int quantity = 1;
    private bool loaded;
    private string? errorMessage;

    private List<Product> availableProducts => products.Where(p => p.Stock > 0).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            products = await db.Products.OrderBy(p => p.Name).ToListAsync();
            selectedProductId = availableProducts.FirstOrDefault()?.Id ?? 0;
            loaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load products: {ex.Message}";
        }
    }

    private void AddLine()
    {
        errorMessage = null;
        var product = products.FirstOrDefault(p => p.Id == selectedProductId);
        if (product is null)
        {
            errorMessage = "Select a product first.";
            return;
        }
        if (quantity < 1)
        {
            errorMessage = "Quantity must be at least 1.";
            return;
        }

        var existing = lines.FirstOrDefault(l => l.ProductId == product.Id);
        var currentInCart = existing?.Quantity ?? 0;
        if (currentInCart + quantity > product.Stock)
        {
            errorMessage = $"Not enough stock for '{product.Name}'. Available: {product.Stock}, already in this sale: {currentInCart}.";
            return;
        }

        if (existing is null)
        {
            lines.Add(new SaleLine(product.Id, product.Name, product.Price, quantity));
        }
        else
        {
            existing.Quantity += quantity;
        }
        quantity = 1;
    }

    private async Task RegisterSaleAsync()
    {
        errorMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Re-load products from the DB to validate stock in a transaction.
            var ids = lines.Select(l => l.ProductId).ToList();
            var dbProducts = await db.Products.Where(p => ids.Contains(p.Id)).ToListAsync();

            var sale = new Sale { Date = DateTime.Now };
            foreach (var line in lines)
            {
                var product = dbProducts.First(p => p.Id == line.ProductId);
                if (line.Quantity > product.Stock)
                {
                    throw new InvalidOperationException($"Not enough stock for '{product.Name}'.");
                }
                product.Stock -= line.Quantity;
                sale.Items.Add(new SaleItem
                {
                    ProductId = product.Id,
                    Quantity = line.Quantity,
                    UnitPrice = product.Price,
                });
            }
            sale.Total = sale.Items.Sum(i => i.LineTotal);
            db.Sales.Add(sale);
            await db.SaveChangesAsync();

            Nav.NavigateTo($"sales/{sale.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not register the sale: {ex.Message}";
        }
    }

    private sealed class SaleLine(int productId, string name, decimal unitPrice, int qty)
    {
        public int ProductId { get; } = productId;
        public string ProductName { get; } = name;
        public decimal UnitPrice { get; } = unitPrice;
        public int Quantity { get; set; } = qty;
        public decimal Subtotal => UnitPrice * Quantity;
    }
}
